# Copy to .env and fill in. Never commit .env.

# Required
DATABASE_URL=postgresql://user:password@host:5432/dbname
SECRET_KEY=long-random-string        # signs session cookies
SETUP_CODE=another-random-string     # needed once, to register the first teacher

# Optional: lesson generation (without it the "New lesson" page shows a notice)
ANTHROPIC_API_KEY=

# Optional: file uploads to DigitalOcean Spaces / any S3 (without it students paste links)
S3_ENDPOINT=https://fra1.digitaloceanspaces.com
S3_REGION=fra1
S3_BUCKET=
S3_KEY=
S3_SECRET=
